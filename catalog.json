{
  "schemaVersion": 2,
  "catalogVersion": "2026.09.24.1",
  "harnesses": [
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "vendor": "Anthropic",
      "status": "supported",
      "lastReviewed": "2026-09-24",
      "documentation": [
        "https://code.claude.com/docs/en/managed-settings",
        "https://code.claude.com/docs/en/managed-mcp",
        "https://code.claude.com/docs/en/settings-reference"
      ],
      "notes": "Mimir writes the file-based managed tier. An MDM profile for com.anthropic.claudecode ranks above the file and, with the default managedSourcesBehavior 'first-wins', hides Mimir's file completely. Deploy settings for Claude Code through Mimir only.",
      "conflictingPreferenceDomains": ["com.anthropic.claudecode"],
      "outputs": [
        {
          "id": "managed-settings",
          "path": "/Library/Application Support/ClaudeCode/managed-settings.json",
          "format": "json",
          "description": "Managed settings (highest file-based precedence; users cannot override).",
          "mergeRules": [
            { "path": "permissions.allow", "strategy": "union" },
            { "path": "permissions.ask", "strategy": "union" },
            { "path": "permissions.deny", "strategy": "union", "denies": "permissions.allow" },
            { "path": "allowedMcpServers", "strategy": "union" },
            { "path": "deniedMcpServers", "strategy": "union", "denies": "allowedMcpServers", "matchField": "serverName" },
            { "path": "availableModels", "strategy": "intersect" },
            { "path": "allowManagedMcpServersOnly", "strategy": "anyTrue" },
            { "path": "allowManagedHooksOnly", "strategy": "anyTrue" },
            { "path": "allowManagedPermissionRulesOnly", "strategy": "anyTrue" },
            { "path": "strictKnownMarketplaces", "strategy": "intersect" },
            { "path": "permissions.disableBypassPermissionsMode", "strategy": "strictest", "order": ["disable"] },
            { "path": "cleanupPeriodDays", "strategy": "min" }
          ]
        },
        {
          "id": "managed-mcp",
          "path": "/Library/Application Support/ClaudeCode/managed-mcp.json",
          "format": "json",
          "description": "Organisation-provided MCP servers ({\"mcpServers\": {name: config}}).",
          "mergeRules": [
            { "path": "mimirDeniedServers", "strategy": "union", "denies": "mcpServers" }
          ],
          "internalKeys": ["mimirDeniedServers"]
        }
      ],
      "detect": {
        "executables": [
          "~/.local/bin/claude",
          "~/.claude/local/claude",
          "~/Library/Application Support/Claude/claude-code/*/claude.app/Contents/MacOS/claude",
          "~/Library/Application Support/Claude/claude-code/*/*/claude.app/Contents/MacOS/claude",
          "~/.npm-global/bin/claude",
          "/opt/homebrew/bin/claude",
          "/usr/local/bin/claude"
        ],
        "processNames": ["claude"],
        "userConfigPaths": ["~/.claude/settings.json", "~/.claude.json"]
      }
    },
    {
      "id": "claude-desktop",
      "displayName": "Claude Desktop",
      "vendor": "Anthropic",
      "status": "experimental",
      "lastReviewed": "2026-09-24",
      "documentation": [
        "https://support.claude.com/en/articles/12622667-enterprise-configuration-for-claude-desktop",
        "https://support.claude.com/en/articles/12611117-deploy-claude-desktop-for-macos"
      ],
      "notes": "Claude Desktop only reads the com.anthropic.claudefordesktop managed-preferences domain; there is no file-based alternative. Mimir writes that plist in /Library/Managed Preferences directly, which Apple does not document for third parties: macOS may remove it when profiles change, and Mimir restores it within seconds. Do not also deploy a vendor profile for this domain. Claude Desktop reads policy at launch; users must restart the app.",
      "outputs": [
        {
          "id": "managed-preferences",
          "path": "/Library/Managed Preferences/com.anthropic.claudefordesktop.plist",
          "format": "plist",
          "description": "Enterprise policy keys for Claude Desktop.",
          "jsonEncodedKeys": ["allowedWorkspaceFolders", "managedMcpServers"],
          "mergeRules": [
            { "path": "allowedWorkspaceFolders", "strategy": "intersect" },
            { "path": "isLocalDevMcpEnabled", "strategy": "anyFalse" },
            { "path": "isDesktopExtensionEnabled", "strategy": "anyFalse" },
            { "path": "isDesktopExtensionDirectoryEnabled", "strategy": "anyFalse" },
            { "path": "isClaudeCodeForDesktopEnabled", "strategy": "anyFalse" },
            { "path": "secureVmFeaturesEnabled", "strategy": "anyFalse" },
            { "path": "disableAutoUpdates", "strategy": "anyTrue" },
            { "path": "autoUpdaterEnforcementHours", "strategy": "min" }
          ]
        }
      ],
      "detect": {
        "appBundleIDs": ["com.anthropic.claudefordesktop"],
        "userConfigPaths": ["~/Library/Application Support/Claude/claude_desktop_config.json"]
      }
    },
    {
      "id": "opencode",
      "displayName": "opencode",
      "vendor": "SST / Anomaly",
      "status": "supported",
      "lastReviewed": "2026-09-24",
      "documentation": ["https://opencode.ai/docs/config/"],
      "notes": "Mimir writes the system managed config, which overrides global, project and remote (.well-known/opencode) config. An MDM profile for ai.opencode.managed also overrides everything and conflicts with Mimir's output.",
      "conflictingPreferenceDomains": ["ai.opencode.managed"],
      "outputs": [
        {
          "id": "managed-config",
          "path": "/Library/Application Support/opencode/opencode.json",
          "format": "json",
          "description": "Managed opencode.json (keys: mcp, permission, provider, model, disabled_providers, enabled_providers, share, autoupdate, …).",
          "mergeRules": [
            { "path": "enabled_providers", "strategy": "intersect" },
            { "path": "disabled_providers", "strategy": "union", "denies": "enabled_providers" },
            { "path": "instructions", "strategy": "union" },
            { "path": "share", "strategy": "strictest", "order": ["disabled", "manual", "auto"] },
            { "path": "permission.*", "strategy": "strictest", "order": ["deny", "ask", "allow"] }
          ]
        }
      ],
      "detect": {
        "executables": [
          "~/.opencode/bin/opencode",
          "~/.npm-global/bin/opencode",
          "/opt/homebrew/bin/opencode",
          "/usr/local/bin/opencode"
        ],
        "processNames": ["opencode"],
        "userConfigPaths": ["~/.config/opencode/opencode.json", "~/.config/opencode/opencode.jsonc"]
      }
    },
    {
      "id": "codex",
      "displayName": "OpenAI Codex CLI",
      "vendor": "OpenAI",
      "status": "supported",
      "lastReviewed": "2026-09-24",
      "documentation": [
        "https://learn.chatgpt.com/docs/enterprise/managed-configuration",
        "https://developers.openai.com/codex/config-reference"
      ],
      "notes": "requirements.toml holds hard constraints users cannot change; managed_config.toml holds managed defaults. Cloud-managed requirements (ChatGPT Business/Enterprise) and an MDM profile for com.openai.codex rank above these files.",
      "conflictingPreferenceDomains": ["com.openai.codex"],
      "outputs": [
        {
          "id": "requirements",
          "path": "/etc/codex/requirements.toml",
          "format": "toml",
          "description": "Admin-enforced requirements (allowed_approval_policies, allowed_sandbox_modes, mcp_servers, features, …).",
          "mergeRules": [
            { "path": "allowed_approval_policies", "strategy": "intersect" },
            { "path": "allowed_sandbox_modes", "strategy": "intersect" },
            { "path": "allowed_login_methods", "strategy": "intersect" },
            { "path": "allowed_chatgpt_workspaces", "strategy": "intersect" }
          ]
        },
        {
          "id": "managed-config",
          "path": "/etc/codex/managed_config.toml",
          "format": "toml",
          "description": "Managed defaults layered above the user's config.toml.",
          "mergeRules": [
            { "path": "approval_policy", "strategy": "strictest", "order": ["untrusted", "on-request", "on-failure", "never"] },
            { "path": "sandbox_mode", "strategy": "strictest", "order": ["read-only", "workspace-write", "danger-full-access"] }
          ]
        }
      ],
      "detect": {
        "executables": [
          "~/.npm-global/bin/codex",
          "~/.local/bin/codex",
          "/opt/homebrew/bin/codex",
          "/usr/local/bin/codex"
        ],
        "processNames": ["codex"],
        "userConfigPaths": ["~/.codex/config.toml"]
      }
    },
    {
      "id": "gemini-cli",
      "displayName": "Gemini CLI",
      "vendor": "Google",
      "status": "planned",
      "lastReviewed": "2026-09-24",
      "documentation": ["https://geminicli.com/docs/cli/enterprise/"],
      "notes": "System overrides at /Library/Application Support/GeminiCli/settings.json and defaults at system-defaults.json in the same folder. Good fit for the next release.",
      "outputs": [],
      "detect": {
        "executables": ["~/.npm-global/bin/gemini", "/opt/homebrew/bin/gemini", "/usr/local/bin/gemini"],
        "processNames": ["gemini"],
        "userConfigPaths": ["~/.gemini/settings.json"]
      }
    },
    {
      "id": "github-copilot-cli",
      "displayName": "GitHub Copilot CLI",
      "vendor": "GitHub",
      "status": "planned",
      "lastReviewed": "2026-09-24",
      "documentation": ["https://docs.github.com/en/copilot/reference/mcp-allowlist-enforcement"],
      "notes": "Enterprise policy (allowedMcpServers / deniedMcpServers) lives in copilot/managed-settings.json of the org's .github-private repository, not on the device. Mimir can inventory it; a local managed file needs research.",
      "outputs": [],
      "detect": {
        "executables": ["~/.npm-global/bin/copilot", "/opt/homebrew/bin/copilot", "/usr/local/bin/copilot"],
        "processNames": ["copilot"],
        "userConfigPaths": ["~/.copilot/config.json", "~/.copilot/mcp-config.json"]
      }
    },
    {
      "id": "cursor",
      "displayName": "Cursor",
      "vendor": "Anysphere",
      "status": "planned",
      "lastReviewed": "2026-09-24",
      "documentation": [
        "https://cursor.com/docs/enterprise/model-and-integration-management",
        "https://cursor.com/docs/enterprise/deployment-patterns"
      ],
      "notes": "MCP allowlists are managed in the Enterprise team dashboard; ~/.cursor/permissions.json (mcpAllowlist) is user-level. Needs research on device-level policy.",
      "outputs": [],
